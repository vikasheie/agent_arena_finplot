# Copy to .env and fill in. .env is gitignored.
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
# Fast/cheap model for categorisation, stronger model for advice + verification
MESH_MODEL_FAST=openai/gpt-4.1-mini
MESH_MODEL_SMART=openai/gpt-4.1

FINPILOT_DB=finpilot.db
# Proactive digest schedule (APScheduler cron fields)
DIGEST_CRON_DAY_OF_WEEK=mon
DIGEST_CRON_HOUR=9
# Optional Telegram delivery for the digest
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
